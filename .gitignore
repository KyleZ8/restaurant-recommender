# under data/fixtures/ (same schema, no real Yelp rows) is committed — see
# data/README.md for how to obtain the real data yourself.
data/raw/
data/processed/

# Pipeline run artifacts.
outputs/

# Source material staging (never committed, never modified).
_source/
